---
import Layout from "../layouts/Layout.astro";
import CvSection from "../components/CvSection.astro";
import CvItem from "../components/CvItem.astro";
import PublicationList from "../components/PublicationList.astro";
import TalkList from "../components/TalkList.astro";
import SocialLinks from "../components/SocialLinks.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config";
import { getList } from "../lib/utils";
import { getPublicationGroups } from "../lib/publications";

const [education, experience, teaching, credentials, awards, service, affiliations, talks] =
  await Promise.all([
    getList("education"),
    getList("experience"),
    getList("teaching"),
    getList("credentials"),
    getList("awards"),
    getList("service"),
    getList("affiliations"),
    getList("talks"),
  ]);
const pubGroups = await getPublicationGroups();
talks.sort((a, b) => +b.date - +a.date);
const training = credentials.filter((c) => c.kind === "training");
const certifications = credentials.filter((c) => c.kind === "certification");
---

<Layout title={`CV · ${siteConfig.name}`} description={`Curriculum vitae of ${siteConfig.fullName}.`}>
  <div class="mx-auto max-w-5xl px-5 pb-20 pt-28 sm:px-8">
    <header class="flex flex-col gap-6 pb-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-sm text-accent">Curriculum Vitae</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight text-fg sm:text-5xl">{siteConfig.fullName}</h1>
        <p class="mt-3 text-muted">
          PhD Candidate, Hydrologic Science &amp; Engineering · Colorado State University · {siteConfig.location}
        </p>
      </div>
      <a
        href={siteConfig.cvPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="no-print inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-accent px-5 py-2.5 font-mono text-sm font-semibold text-bg transition-colors hover:bg-accent-strong sm:self-auto"
      >
        <Icon name="download" class="h-4 w-4" /> PDF version
      </a>
    </header>

    <CvSection title="Education">
      <div class="space-y-6">
        {
          education.map((e) => (
            <CvItem title={e.degree} date={e.dates} subtitle={e.school}>
              {e.details?.map((d) => (
                <p class="mt-1 text-sm text-muted">
                  <span class="text-subtle">{d.label}:</span>{" "}
                  {d.url ? (
                    <a href={d.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">{d.text}</a>
                  ) : (
                    d.text
                  )}
                </p>
              ))}
              {e.areas && (
                <>
                  <p class="mt-1 text-sm text-subtle">Research areas:</p>
                  <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-muted marker:text-subtle">
                    {e.areas.map((a) => <li>{a}</li>)}
                  </ul>
                </>
              )}
            </CvItem>
          ))
        }
      </div>
    </CvSection>

    <CvSection title="Research & Professional Experience">
      <div class="space-y-6">
        {
          experience.map((j) => (
            <CvItem title={j.title} date={j.dates} subtitle={[j.org, j.location].filter(Boolean).join(", ")}>
              {j.bullets && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted marker:text-subtle">
                  {j.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </CvItem>
          ))
        }
      </div>
    </CvSection>

    <CvSection title="Teaching Experience" id="teaching">
      <div class="space-y-6">
        {
          teaching.map((t) => (
            <CvItem title={t.title} date={t.dates} subtitle={[t.department, t.org, t.location].filter(Boolean).join(", ")}>
              {t.courses && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted marker:text-subtle">
                  {t.courses.map((c) => <li>{c}</li>)}
                </ul>
              )}
            </CvItem>
          ))
        }
      </div>
    </CvSection>

    <CvSection title="Certifications & Training">
      <div class="space-y-8">
        {
          [
            { label: "Specialized training", items: training },
            { label: "Certifications", items: certifications },
          ]
            .filter((g) => g.items.length)
            .map((g) => (
              <div>
                <h3 class="mb-4 font-mono text-xs uppercase tracking-wider text-subtle">{g.label}</h3>
                <div class="space-y-5">
                  {g.items.map((c) => (
                    <CvItem title={c.title} date={c.date} subtitle={c.issuer}>
                      {c.note && <p class="mt-0.5 text-sm text-subtle">{c.note}</p>}
                      {c.bullets && (
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted marker:text-subtle">
                          {c.bullets.map((b) => <li>{b}</li>)}
                        </ul>
                      )}
                    </CvItem>
                  ))}
                </div>
              </div>
            ))
        }
      </div>
    </CvSection>

    <CvSection title="Awards & Honors">
      <div class="space-y-4">
        {
          awards.map((a) => (
            <CvItem title={a.title} date={a.date} url={a.url} subtitle={a.note} />
          ))
        }
      </div>
    </CvSection>

    <CvSection title="Service & Leadership">
      <div class="space-y-4">
        {service.map((s) => <CvItem title={s.title} date={s.date} url={s.url} subtitle={s.note} />)}
      </div>
    </CvSection>

    <CvSection title="Publications" id="publications">
      <div class="space-y-10">
        {
          pubGroups.map((g) => (
            <div>
              <h3 class="mb-4 font-mono text-xs uppercase tracking-wider text-subtle">{g.label}</h3>
              <PublicationList items={g.items} />
            </div>
          ))
        }
      </div>
    </CvSection>

    <CvSection title="Talks & Posters" id="talks">
      <TalkList items={talks} />
    </CvSection>

    <CvSection title="Affiliations">
      <div class="space-y-4">
        {affiliations.map((a) => <CvItem title={a.org} subtitle={a.role} />)}
      </div>
    </CvSection>

    <div class="no-print flex items-center justify-between border-t border-line pt-10">
      <a href="/" class="font-mono text-sm text-accent hover:text-accent-strong">← Home</a>
      <SocialLinks iconClass="h-5 w-5" />
    </div>
  </div>
</Layout>
