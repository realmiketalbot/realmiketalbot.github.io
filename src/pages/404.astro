---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found · Mike Talbot">
  <section class="mx-auto flex min-h-[70vh] max-w-3xl flex-col justify-center px-5 pt-24 sm:px-8">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-fg sm:text-5xl">Out of bounds.</h1>
    <p class="mt-4 text-lg text-muted">
      This page doesn't exist anymore, or never did. The old blog has been retired.
    </p>
    <a href="/" class="mt-8 font-mono text-sm text-accent hover:text-accent-strong">← Back home</a>
  </section>
</Layout>
