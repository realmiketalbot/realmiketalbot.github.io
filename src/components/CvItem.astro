---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  date?: string;
  url?: string;
  subtitle?: string;
}
const { title, date, url, subtitle } = Astro.props;
---

<div class="break-inside-avoid">
  <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <p class="font-medium text-fg">
      {title}
      {
        url && (
          <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Link: ${title}`} class="no-print ml-1 inline-block align-[-2px] text-subtle hover:text-accent">
            <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
          </a>
        )
      }
    </p>
    {date && <span class="shrink-0 font-mono text-xs text-subtle sm:text-sm">{date}</span>}
  </div>
  {subtitle && <p class="mt-0.5 text-sm text-muted">{subtitle}</p>}
  <slot />
</div>
