---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const {
  title = `${siteConfig.name} · ${siteConfig.title}`,
  description = siteConfig.description,
  home = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<!-- Dark by default; the inline script below switches to light if the visitor chose it -->
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light")
          document.documentElement.classList.remove("dark");
      } catch (e) {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#0a0e13" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(siteConfig.headshot.src, Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    {/* GoatCounter analytics; production builds only so local dev visits aren't counted */}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter="https://mtalbot.goatcounter.com/count"
          async
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body class="min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-bg"
      >Skip to content</a
    >
    <Header home={home} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
