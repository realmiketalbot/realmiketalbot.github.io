---
import SectionHeading from "./SectionHeading.astro";
import { getList } from "../lib/utils";
const education = await getList("education");
---

<section id="education" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 lg:py-28">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeading index="06" title="Education" />
    </div>
    <div class="space-y-5 lg:col-span-8">
      {
        education.map((e) => (
          <div class="rounded-2xl border border-line bg-surface p-6">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="text-lg font-semibold text-fg">{e.degree}</h3>
              <span class="shrink-0 font-mono text-xs text-subtle sm:text-sm">{e.dates}</span>
            </div>
            <p class="mt-0.5 text-accent">{e.school}</p>
            {e.details && (
              <dl class="mt-4 space-y-2 text-sm">
                {e.details.map((d) => (
                  <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-3">
                    <dt class="w-20 shrink-0 font-mono text-xs uppercase tracking-wider text-subtle sm:pt-0.5">
                      {d.label}
                    </dt>
                    <dd class="text-muted">
                      {d.url ? (
                        <a href={d.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">
                          {d.text}
                        </a>
                      ) : (
                        d.text
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
