---
import Icon from "./Icon.astro";
import { boldMe, formatMonthYear } from "../lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  items: CollectionEntry<"talks">["data"][];
}
const { items } = Astro.props;
---

<ul class="space-y-6">
  {
    items.map((t) => (
      <li>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-subtle">
            <span
              class:list={[
                "rounded px-1.5 py-0.5",
                t.type === "Poster" ? "bg-surface-2 text-fg" : "bg-accent-soft text-accent",
              ]}
            >
              {t.type}
            </span>
            <span>{formatMonthYear(t.date)}</span>
            <span aria-hidden="true">·</span>
            <span>{t.location}</span>
          </div>
          <p class="mt-1.5 font-medium leading-snug text-fg">{t.title}</p>
          <p class="mt-1 text-sm text-muted">
            <span set:html={boldMe(t.authors)} /> · <span class="italic">{t.event}</span>
          </p>
          {(t.slides || t.link) && (
            <div class="mt-2 flex gap-4 font-mono text-xs">
              {t.slides && (
                <a href={t.slides} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-accent hover:text-accent-strong">
                  Slides <Icon name="arrow-up-right" class="h-3 w-3" />
                </a>
              )}
              {t.link && (
                <a href={t.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-accent hover:text-accent-strong">
                  Abstract <Icon name="arrow-up-right" class="h-3 w-3" />
                </a>
              )}
            </div>
          )}
        </div>
      </li>
    ))
  }
</ul>
