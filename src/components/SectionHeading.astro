---
interface Props {
  title: string;
  index?: string;
}
const { title, index } = Astro.props;
---

<div class="lg:sticky lg:top-24">
  {index && <p class="font-mono text-sm text-accent">{index}</p>}
  <h2 class="mt-1 text-3xl font-bold tracking-tight text-fg sm:text-4xl xl:text-5xl">
    {title}
  </h2>
  <div class="mt-3 h-[4px] w-[64px] rounded-full bg-accent"></div>
</div>
