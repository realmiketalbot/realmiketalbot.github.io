---
import Layout from "../layouts/Layout.astro";
import CvSection from "../components/CvSection.astro";
import CvItem from "../components/CvItem.astro";
import PublicationList from "../components/PublicationList.astro";
import TalkList from "../components/TalkList.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config";
import { getCvData, CV_SECTIONS as S } from "../lib/cv";

const cv = await getCvData();
---

<Layout title={`CV · ${siteConfig.name}`} description={`Curriculum vitae of ${siteConfig.fullName}.`}>
  <div class="mx-auto max-w-5xl px-5 pb-20 pt-28 sm:px-8">
    <header class="flex flex-col gap-6 pb-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-sm text-accent">Curriculum Vitae</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight text-fg sm:text-5xl">{siteConfig.fullName}</h1>
        <p class="mt-3 text-muted">
          {siteConfig.cvHeadline} · {siteConfig.affiliation} · {siteConfig.location}
        </p>
        {
          siteConfig.social.email && (
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="mt-2 inline-flex items-center gap-2 font-mono text-sm text-accent hover:text-accent-strong"
            >
              <Icon name="email" class="h-4 w-4" /> {siteConfig.social.email}
            </a>
          )
        }
      </div>
      <a
        href={siteConfig.cvPdf}
        target="_blank"
        rel="noopener noreferrer"
        class="no-print inline-flex shrink-0 items-center gap-2 self-start rounded-full bg-accent px-5 py-2.5 font-mono text-sm font-semibold text-bg transition-colors hover:bg-accent-strong sm:self-auto"
      >
        <Icon name="download" class="h-4 w-4" /> PDF version
      </a>
    </header>

    <CvSection title={S.education}>
      <div class="space-y-6">
        {
          cv.education.map((e) => (
            <CvItem title={e.degree} date={e.dates} subtitle={e.school}>
              {e.details?.map((d) => (
                <p class="mt-1 text-sm text-muted">
                  <span class="text-subtle">{d.label}:</span>{" "}
                  {d.url ? (
                    <a href={d.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent">{d.text}</a>
                  ) : (
                    d.text
                  )}
                </p>
              ))}
              {e.areas && (
                <>
                  <p class="mt-1 text-sm text-subtle">Research areas:</p>
                  <ul class="mt-1 list-disc space-y-0.5 pl-5 text-sm text-muted marker:text-subtle">
                    {e.areas.map((a) => <li>{a}</li>)}
                  </ul>
                </>
              )}
            </CvItem>
          ))
        }
      </div>
    </CvSection>

    <CvSection title={S.experience}>
      <div class="space-y-6">
        {
          cv.experience.map((j) => (
            <CvItem title={j.title} date={j.dates} subtitle={[j.org, j.location].filter(Boolean).join(", ")}>
              {j.bullets && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted marker:text-subtle">
                  {j.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </CvItem>
          ))
        }
      </div>
    </CvSection>

    <CvSection title={S.teaching} id="teaching">
      <div class="space-y-6">
        {
          cv.teaching.map((t) => (
            <CvItem title={t.title} date={t.dates} subtitle={[t.department, t.org, t.location].filter(Boolean).join(", ")}>
              {t.courses && (
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted marker:text-subtle">
                  {t.courses.map((c) => <li>{c}</li>)}
                </ul>
              )}
            </CvItem>
          ))
        }
      </div>
    </CvSection>

    <CvSection title={S.publications} id="publications">
      <div class="space-y-10">
        {
          cv.pubGroups.map((g) => (
            <div>
              <h3 class="mb-4 font-mono text-xs uppercase tracking-wider text-subtle">{g.label}</h3>
              <PublicationList items={g.items} />
            </div>
          ))
        }
      </div>
    </CvSection>

    <CvSection title={S.talks} id="talks">
      <TalkList items={cv.talks} />
    </CvSection>

    <CvSection title={S.awards}>
      <div class="space-y-4">
        {cv.awards.map((a) => <CvItem title={a.title} date={a.date} url={a.url} subtitle={a.note} />)}
      </div>
    </CvSection>

    <CvSection title={S.service}>
      <div class="space-y-4">
        {cv.service.map((s) => <CvItem title={s.title} date={s.date} url={s.url} subtitle={s.note} />)}
      </div>
    </CvSection>

    <CvSection title={S.credentials}>
      <div class="space-y-8">
        {
          [
            { label: "Specialized training", items: cv.training },
            { label: "Certifications", items: cv.certifications },
          ]
            .filter((g) => g.items.length)
            .map((g) => (
              <div>
                <h3 class="mb-4 font-mono text-xs uppercase tracking-wider text-subtle">{g.label}</h3>
                <div class="space-y-5">
                  {g.items.map((c) => (
                    <CvItem title={c.title} date={c.date} subtitle={c.issuer}>
                      {c.note && <p class="mt-0.5 text-sm text-subtle">{c.note}</p>}
                      {c.bullets && (
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted marker:text-subtle">
                          {c.bullets.map((b) => <li>{b}</li>)}
                        </ul>
                      )}
                    </CvItem>
                  ))}
                </div>
              </div>
            ))
        }
      </div>
    </CvSection>

    <CvSection title={S.affiliations}>
      <div class="space-y-4">
        {cv.affiliations.map((a) => <CvItem title={a.org} subtitle={a.role} />)}
      </div>
    </CvSection>
  </div>
</Layout>
